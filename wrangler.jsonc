{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "package",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "package.yukurust.com",
      "custom_domain": true
    }
  ]
}
